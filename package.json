{
  "name": "agentic-lang",
  "version": "0.1.0",
  "description": "AI-native programming language with uncertainty as a first-class citizen",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agentic": "./bin/agentic.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest",
    "dev": "ts-node src/cli.ts",
    "example": "npm run build && node bin/agentic.js compile examples/auth.agentic --output examples/auth.ts"
  },
  "keywords": [
    "programming-language",
    "transpiler",
    "ai-native",
    "property-based-testing",
    "uncertainty",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "commander": "^12.0.0",
    "source-map": "^0.7.4",
    "tree-sitter": "^0.21.0",
    "tree-sitter-typescript": "^0.21.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "z3-solver": "^4.15.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.1.0",
    "@stryker-mutator/core": "^9.4.0",
    "@stryker-mutator/typescript-checker": "^9.4.0",
    "@types/node": "^20.11.5",
    "@types/source-map": "^0.5.7",
    "eslint-plugin-functional": "^9.0.2",
    "fast-check": "^3.15.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.16",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
